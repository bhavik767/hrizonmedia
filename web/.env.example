# PostgreSQL connection string. Hetzner Compose supplies the private service address.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD_HERE@127.0.0.1:5432/payload

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Canonical origin used by server-only code. Set this in Docker deployments so
# origin checks do not depend on a build-time NEXT_PUBLIC_SERVER_URL value.
SERVER_URL=http://localhost:3000

# Provider-neutral deployment stage. Use staging only for an isolated staging stack.
DEPLOYMENT_ENVIRONMENT=development

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# HMAC secret for signed transcoder callbacks
TRANSCODER_CALLBACK_SECRET=YOUR_CALLBACK_SECRET_HERE

# Salad Job Queue control plane and native Svix webhook verification. Configure
# these only together with the dedicated video S3 and CloudFront values below.
# SALAD_API_KEY=YOUR_SALAD_API_KEY_HERE
# SALAD_ORGANIZATION_NAME=hrizonmedia
# SALAD_PROJECT_NAME=hrizonmedia-staging
# SALAD_QUEUE_NAME=video-transcoding
# SALAD_WEBHOOK_SECRET=YOUR_SVIX_WEBHOOK_SECRET_HERE

# DoveRunner token-proxy credentials. These remain in the web service only; the
# encryption token belongs exclusively to the Salad worker configuration.
# DOVERUNNER_SITE_ID=GXIW
# DOVERUNNER_SITE_KEY=YOUR_32_BYTE_SITE_KEY_HERE
# DOVERUNNER_ACCESS_KEY=YOUR_ACCESS_KEY_HERE

# Default provider concurrency until an operator saves a persisted setting
MEDIA_PROVIDER_CONCURRENCY=2

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Password for the local Postgres container (docker-compose)
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# Private S3-compatible CMS storage. Hetzner loads these from an external env file;
# the database, Payload secret, and all four bucket values are validated at startup.
# BUCKET=YOUR_CMS_BUCKET_HERE
# ACCESS_KEY_ID=YOUR_CMS_STORAGE_ACCESS_KEY_HERE
# SECRET_ACCESS_KEY=YOUR_CMS_STORAGE_SECRET_HERE
# ENDPOINT=https://YOUR_S3_ENDPOINT_HERE
# REGION=YOUR_S3_REGION_HERE
# AWS_S3_URL_STYLE=path

# Dedicated private video storage and CloudFront delivery (not the CMS bucket).
# VIDEO_S3_ACCESS_KEY_ID=YOUR_VIDEO_S3_ACCESS_KEY_HERE
# VIDEO_S3_SECRET_ACCESS_KEY=YOUR_VIDEO_S3_SECRET_HERE
# VIDEO_S3_BUCKET=hrizonmedia-video-staging-1
# VIDEO_S3_REGION=ap-south-1
# VIDEO_CLOUDFRONT_DOMAIN=dbjfbyqkep4un.cloudfront.net
# VIDEO_CLOUDFRONT_KEY_PAIR_ID=YOUR_KEY_PAIR_ID_HERE
# VIDEO_CLOUDFRONT_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# Production-mode fake providers are permitted only on an explicitly isolated staging stack.
# DEPLOYMENT_ENVIRONMENT=staging
