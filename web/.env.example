# PostgreSQL connection string. Railway supplies its service reference in production.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD_HERE@127.0.0.1:5432/payload

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Password for the local Postgres container (docker-compose)
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# Railway private Storage Bucket credentials. The database, Payload secret, and
# all four bucket values are validated before the production container starts.
# BUCKET=${{Bucket.BUCKET}}
# ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
# SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
# ENDPOINT=${{Bucket.ENDPOINT}}
# REGION=${{Bucket.REGION}}
# AWS_S3_URL_STYLE=path

# Railway supplies this automatically. Fake media providers are allowed only when
# the value is staging; production-mode deployments otherwise reject them.
# RAILWAY_ENVIRONMENT_NAME=staging
